# ============================================
# CLAWED UP GLAM - Environment Configuration
# ============================================
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control!

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# ============================================
# OWNER NOTIFICATION SETTINGS (REQUIRED)
# ============================================
# These are where YOU (the salon owner) receive
# appointment requests with Accept/Decline buttons

OWNER_PHONE=6394140862
OWNER_EMAIL=clawedupglambybanne@gmail.com
ADMIN_EMAIL=clawedupglambybanne@gmail.com

# ============================================
# TWILIO SMS CONFIGURATION
# ============================================
# Sign up at https://www.twilio.com
# Get your credentials from: https://console.twilio.com

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# EMAIL SMTP CONFIGURATION
# ============================================
# For Gmail: Use an App Password (not your regular password)
# 1. Enable 2FA on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
#
# For other providers, use their SMTP settings

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clawedupglambybanne@gmail.com
SMTP_PASS=lvmp aobg crwa ypey

