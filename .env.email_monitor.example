# ============================================
# EMAIL APPROVAL MONITOR CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# EMAIL MONITORING SETTINGS
# ============================================

# The email address to monitor for incoming approval/rejection emails
# This is the inbox that will receive the approval response emails
MONITOR_EMAIL=your-email@gmail.com

# Email password (for Gmail, use an App Password, NOT your regular password)
# See setup instructions for how to create an App Password
MONITOR_EMAIL_PASSWORD=your-app-password-here

# IMAP server settings (defaults are for Gmail)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# ============================================
# SECURITY SETTINGS
# ============================================

# CRITICAL: Only emails FROM this address will be processed
# This prevents unauthorized users from approving/declining appointments
# Use YOUR personal/admin email address that you will send approvals from
AUTHORIZED_SENDER_EMAIL=your-admin-email@gmail.com

# ============================================
# AUTOMATION SETTINGS
# ============================================

# How often to check for new emails (in seconds)
# Default: 30 seconds
POLL_INTERVAL=30

# ============================================
# EXISTING APP SETTINGS (from your server.js)
# ============================================

# These should match your existing .env file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

ADMIN_EMAIL=your-admin-email@gmail.com

# Salon configuration
SALON_PHONE=(555) 123-4567
SALON_ADDRESS=123 Beauty Lane, Glamour City
SALON_EMAIL=appointments@clawedupglam.com

# Server settings
PORT=3000
BASE_URL=http://localhost:3000
